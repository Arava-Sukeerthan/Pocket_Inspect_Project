{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pocketinspect/step10d/device_characterization_schema.json",
  "title": "PocketInspect Step 10D device characterization records",
  "description": "Specification schema (Step 10D). Contains no data. Status and value are separate: any state other than AVAILABLE requires value = null (no fake zeros). Known specifications are stored separately from observations and are never measurements.",
  "$defs": {
    "runtime_state": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE",
        "PERMISSION_REQUIRED",
        "API_UNSUPPORTED",
        "EXTERNAL_REQUIRED",
        "NOT_TESTED",
        "ERROR"
      ]
    },
    "report_status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "AVAILABLE",
        "CONDITIONALLY AVAILABLE",
        "UNAVAILABLE",
        "REQUIRES EXTERNAL INSTRUMENTATION",
        "REQUIRES PILOT VALIDATION",
        "NOT YET VERIFIED"
      ]
    },
    "capability_result": {
      "type": "object",
      "description": "One capability check. If state is not AVAILABLE, value must be null.",
      "properties": {
        "metric": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/runtime_state"
        },
        "report_status": {
          "$ref": "#/$defs/report_status"
        },
        "value": {
          "description": "Observed value; null unless state is AVAILABLE"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string",
          "description": "API, file path, ADB command or instrument"
        },
        "min_api": {
          "type": [
            "integer",
            "null"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. host ADB, permission, system property"
        },
        "verified": {
          "type": "boolean",
          "description": "True only if observed on the physical device with stored evidence and checked semantics"
        },
        "verification_method": {
          "type": "string"
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Path/hash of raw output stored with the run"
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 8601 timestamp of the observation"
        },
        "error_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "metric",
        "state",
        "report_status",
        "value",
        "unit",
        "source",
        "verified",
        "verification_method"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "UNAVAILABLE",
                  "PERMISSION_REQUIRED",
                  "API_UNSUPPORTED",
                  "EXTERNAL_REQUIRED",
                  "NOT_TESTED",
                  "ERROR"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "verified": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verified": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "const": "AVAILABLE"
              },
              "report_status": {
                "const": "VERIFIED"
              },
              "evidence_ref": {
                "type": "string"
              }
            },
            "required": [
              "evidence_ref",
              "observed_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "report_status": {
                "const": "VERIFIED"
              }
            }
          },
          "then": {
            "properties": {
              "verified": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "known_specification": {
      "type": "object",
      "description": "Researcher-provided manufacturer specification. Never a measurement.",
      "properties": {
        "manufacturer": {
          "const": "OPPO"
        },
        "model": {
          "const": "OPPO A5 2020"
        },
        "ram_variant": {
          "const": "3 GB"
        },
        "excluded_variants": {
          "const": [
            "4 GB",
            "6 GB"
          ]
        },
        "storage": {
          "type": "string"
        },
        "soc": {
          "type": "string"
        },
        "gpu": {
          "type": "string"
        },
        "android_launch_version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "manufacturer",
        "model",
        "ram_variant",
        "excluded_variants",
        "source"
      ],
      "additionalProperties": false
    },
    "device_identity": {
      "type": "object",
      "properties": {
        "device_unit_id": {
          "type": "string"
        },
        "known_specification": {
          "$ref": "#/$defs/known_specification"
        },
        "observed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability_result"
          },
          "description": "Build fields, totalMem, storage, SoC/GPU identification, Android version, API level, security patch, fingerprint"
        },
        "variant_check": {
          "$ref": "#/$defs/capability_result"
        }
      },
      "required": [
        "device_unit_id",
        "known_specification",
        "observed",
        "variant_check"
      ],
      "additionalProperties": false
    },
    "telemetry_capability": {
      "type": "object",
      "properties": {
        "dimension": {
          "enum": [
            "battery",
            "memory",
            "cpu",
            "gpu",
            "thermal"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability_result"
          }
        },
        "resource_state_input": {
          "type": "boolean",
          "description": "Candidate input to the R0-R3 estimator (latency/accuracy/confidence never)"
        },
        "reliability": {
          "type": "string",
          "enum": [
            "REQUIRES PILOT VALIDATION",
            "NOT YET VERIFIED"
          ]
        }
      },
      "required": [
        "dimension",
        "results",
        "resource_state_input",
        "reliability"
      ],
      "additionalProperties": false
    },
    "camera_capability": {
      "type": "object",
      "properties": {
        "camera_id": {
          "type": "string"
        },
        "lens_facing": {
          "type": [
            "string",
            "null"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability_result"
          }
        },
        "manual_control_honoured": {
          "$ref": "#/$defs/capability_result"
        }
      },
      "required": [
        "camera_id",
        "results",
        "manual_control_honoured"
      ],
      "additionalProperties": false
    },
    "backend_capability": {
      "type": "object",
      "description": "Capability only. No latency or accuracy fields exist by design.",
      "properties": {
        "backend": {
          "type": "string"
        },
        "runtime_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "availability": {
          "$ref": "#/$defs/capability_result"
        },
        "delegation": {
          "$ref": "#/$defs/capability_result"
        },
        "quantization_support": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability_result"
          }
        },
        "probability_output": {
          "$ref": "#/$defs/capability_result"
        },
        "reference_graph_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "known_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "backend",
        "availability",
        "delegation",
        "probability_output",
        "known_limitations"
      ],
      "additionalProperties": false
    },
    "thermal_capability": {
      "type": "object",
      "description": "Temperature measurement and throttling state kept separate.",
      "properties": {
        "thermal_status_api": {
          "$ref": "#/$defs/capability_result"
        },
        "thermal_headroom_api": {
          "$ref": "#/$defs/capability_result"
        },
        "temperature_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability_result"
          }
        },
        "frequency_capping_observable": {
          "$ref": "#/$defs/capability_result"
        },
        "external_surface_probe": {
          "$ref": "#/$defs/capability_result"
        },
        "selected_thermal_source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "platform_thermal_status",
            "fallback_temperature_and_frequency_capping",
            null
          ]
        }
      },
      "required": [
        "thermal_status_api",
        "temperature_sources",
        "frequency_capping_observable",
        "external_surface_probe",
        "selected_thermal_source"
      ],
      "additionalProperties": false
    },
    "energy_capability": {
      "type": "object",
      "description": "Feasibility only; no energy value and no accuracy value.",
      "properties": {
        "E1_battery_side_reference": {
          "$ref": "#/$defs/capability_result"
        },
        "E2_supply_powered_session": {
          "$ref": "#/$defs/capability_result"
        },
        "E3_software_counters": {
          "$ref": "#/$defs/capability_result"
        },
        "selected_level": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "E-1",
            "E-2",
            "E-3",
            null
          ]
        },
        "absolute_energy_claimed": {
          "const": false
        }
      },
      "required": [
        "E1_battery_side_reference",
        "E2_supply_powered_session",
        "E3_software_counters",
        "selected_level",
        "absolute_energy_claimed"
      ],
      "additionalProperties": false
    },
    "characterization_run": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "repeat_index": {
          "type": "integer"
        },
        "app_version": {
          "type": "string"
        },
        "git_commit": {
          "type": "string"
        },
        "host_tool_versions": {
          "type": "object"
        },
        "device_identity": {
          "$ref": "#/$defs/device_identity"
        },
        "telemetry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/telemetry_capability"
          }
        },
        "camera": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/camera_capability"
          }
        },
        "backends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/backend_capability"
          }
        },
        "profiling": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability_result"
          }
        },
        "thermal": {
          "$ref": "#/$defs/thermal_capability"
        },
        "energy": {
          "$ref": "#/$defs/energy_capability"
        },
        "conditions": {
          "type": "object",
          "description": "charging, network, USB, ColorOS settings during the run"
        },
        "performance_results": {
          "const": null,
          "description": "Step 10D records no performance results"
        }
      },
      "required": [
        "run_id",
        "started_at",
        "app_version",
        "git_commit",
        "device_identity",
        "telemetry",
        "camera",
        "backends",
        "profiling",
        "thermal",
        "energy",
        "conditions"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/characterization_run"
}
